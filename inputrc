# -----------------------------------------------------------------
# 核心模式设置：开启万物皆可 Vim 的体验
# -----------------------------------------------------------------
# 开启 Vi 编辑模式 
set editing-mode vi

# 搜索补全时不区分大小写（除非输入了大写字母）
set completion-ignore-case on
# 开启智能补全显示，提高命令输入效率
set show-all-if-ambiguous on

# -----------------------------------------------------------------
# 模式特定映射：修复插入模式下的功能缺失
# -----------------------------------------------------------------
$if mode=vi
    # --- 插入模式 (vi-insert) ---
    set keymap vi-insert
    # 修复你提到的 Ctrl+L 清屏问题
    "\C-l": clear-screen
    # 允许在插入模式下使用 Emacs 风格的跳行快捷键，增加灵活性
    "\C-a": beginning-of-line
    "\C-e": end-of-line
    # 快速删除光标前的一个单词
    "\C-w": backward-kill-word

    # --- 普通模式 (vi-command) ---
    set keymap vi-command
    # 确保在普通模式下 Ctrl+L 也能清屏
    "\C-l": clear-screen
$endif

# -----------------------------------------------------------------
# 视觉反馈与补全增强
# -----------------------------------------------------------------
# 补全时显示文件类型标识（目录/，可执行文件*）
set visible-stats on
# 按一次 Tab 即显示补全列表，减少按键次数
set show-all-if-unmodified on
# 补全项较多时不询问，直接列出
set completion-query-items 0
